<Window x:Class="ForegroundTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ForegroundTracker"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Activated="MainWindow_OnActivated"
        Deactivated="MainWindow_OnDeactivated"
        GotKeyboardFocus="MainWindow_OnGotKeyboardFocus"
        LostKeyboardFocus="MainWindow_OnLostKeyboardFocus"
        Topmost="True">
    <DockPanel Margin="8">
        <Button DockPanel.Dock="Top" Content="Clear" HorizontalAlignment="Left"
                Padding="12,4" Margin="0,0,0,6" Click="ClearButton_Click"/>
        <ListBox x:Name="EventListBox"
                 ItemsSource="{x:Static local:EventLog.Entries}"
                 FontFamily="Consolas" FontSize="12"/>
    </DockPanel>
</Window>
